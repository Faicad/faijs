{
  "name": "@faicad/faijs",
  "version": "0.9.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./csg": {
      "types": "./dist/csg.d.ts",
      "import": "./dist/csg.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "import": "./dist/sdf.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./faqts": {
      "types": "./dist/faqts/index.d.ts",
      "import": "./dist/faqts/index.js"
    },
    "./faqts/node": {
      "types": "./dist/faqts/node.d.ts",
      "import": "./dist/faqts/node.js"
    },
    "./faqts/browser": {
      "types": "./dist/faqts/browser.d.ts",
      "import": "./dist/faqts/browser.js"
    },
    "./module-resolver": {
      "types": "./dist/module-resolver/index.d.ts",
      "import": "./dist/module-resolver/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    }
  },
  "files": [
    "dist/"
  ],
  "description": "Faicad CAD execution engine — faijs language parser, BREP/mesh geometry ops, CadRuntime",
  "license": "Apache-2.0",
  "keywords": [
    "cad",
    "faijs",
    "brep",
    "mesh",
    "manifold",
    "occt",
    "parametric",
    "geometry"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/Faicad/faijs.git"
  },
  "scripts": {
    "build": "npm run clean && npm run build -w @faicad/faijs-core && tsc -p tsconfig.build.json && node scripts/fix-import-extensions.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "pack": "npm run build && npm pack",
    "prepack": "npm run build",
    "prepare": "node scripts/install-lefthook.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages/core/src packages/gear-lib-demo/src",
    "verify-md-links": "npx tsx scripts/verify-md-links.ts",
    "verify-md-wrap": "npx tsx scripts/verify-md-wrap.ts",
    "verify-doc-budgets": "npx tsx scripts/verify-doc-budgets.ts",
    "verify-agent-note-format": "npx tsx scripts/verify-agent-note-format.ts",
    "verify-agent-note-classification": "npx tsx scripts/verify-agent-note-classification.ts",
    "verify-translation-pairing": "npx tsx scripts/verify-translation-pairing.ts",
    "verify-type-equiv": "npx tsx scripts/verify-type-equiv.ts",
    "verify-mermaid": "npx tsx scripts/verify-mermaid.ts",
    "verify-export-jsdoc": "npx tsx scripts/verify-export-jsdoc.ts",
    "doc-typecheck": "npx tsx scripts/doc-typecheck.ts",
    "verify-doc-refs": "npx tsx scripts/verify-doc-refs.ts",
    "verify-archived-agent-notes": "npx tsx scripts/verify-archived-agent-notes.ts",
    "archive-plans": "node scripts/archive-plans.mjs",
    "gen-ops-api-inventory": "npx tsx scripts/gen-ops-api-inventory.ts",
    "check-ops-api-inventory": "npx tsx scripts/gen-ops-api-inventory.ts --check",
    "doc-sync": "npx tsx scripts/gen-ops-api-inventory.ts --check && npx tsx scripts/verify-md-links.ts && npx tsx scripts/verify-md-wrap.ts && npx tsx scripts/verify-doc-budgets.ts && npx tsx scripts/verify-agent-note-format.ts && npx tsx scripts/verify-agent-note-classification.ts && npx tsx scripts/verify-translation-pairing.ts && npx tsx scripts/verify-type-equiv.ts && npx tsx scripts/verify-mermaid.ts && npx tsx scripts/verify-export-jsdoc.ts && npx tsx scripts/doc-typecheck.ts && npx tsx scripts/verify-doc-refs.ts && npx tsx scripts/verify-archived-agent-notes.ts",
    "test:watchdog": "node scripts/run-tests-with-watchdog.mjs -- npm run test",
    "test:workspaces:watchdog": "node scripts/run-tests-with-watchdog.mjs -- npm run test --workspaces --if-present"
  },
  "workspaces": [
    "packages/core",
    "packages/gear-lib-demo",
    "packages/sheetmetal",
    "packages/fixtures",
    "packages/tests",
    "packages/demo"
  ],
  "dependencies": {
    "@faicad/faijs-core": "*",
    "occt-wasm": "3.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.4",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xmldom/xmldom": "^0.9.11",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.12",
    "madge": "^8.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "occt-wasm": "3.8.4"
  }
}
