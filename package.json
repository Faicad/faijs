{
  "name": "@faicad/faijs-monorepo",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "config": {
    "faijsVersion": "0.30.3"
  },
  "description": "Faicad faijs monorepo — CAD execution engine (@faicad/faijs) and companion libraries",
  "license": "Apache-2.0",
  "keywords": [
    "cad",
    "faijs",
    "brep",
    "mesh",
    "manifold",
    "occt",
    "parametric",
    "geometry"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/Faicad/faijs.git"
  },
  "scripts": {
    "build": "npm run build -w @faicad/faijs && npm run build -w @faicad/faijs-draw && npm run build -w @faicad/faijs-sketch && npm run build -w @faicad/faijs-extra && npm run build -w @faicad/faijs-viewer && npm run build -w @faicad/sheetmetal && npm run build -w @faicad/faijs-gears",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "node scripts/install-lefthook.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/core/src packages/faijs-extra/src packages/draw/src",
    "verify-md-links": "npx tsx scripts/verify-md-links.ts",
    "verify-md-wrap": "npx tsx scripts/verify-md-wrap.ts",
    "verify-agent-note-format": "npx tsx scripts/verify-agent-note-format.ts",
    "verify-agent-note-classification": "npx tsx scripts/verify-agent-note-classification.ts",
    "verify-translation-pairing": "npx tsx scripts/verify-translation-pairing.ts",
    "verify-type-equiv": "npx tsx scripts/verify-type-equiv.ts",
    "verify-mermaid": "npx tsx scripts/verify-mermaid.ts",
    "verify-export-jsdoc": "npx tsx scripts/verify-export-jsdoc.ts",
    "doc-typecheck": "npx tsx scripts/doc-typecheck.ts",
    "verify-doc-refs": "npx tsx scripts/verify-doc-refs.ts",
    "verify-archived-agent-notes": "npx tsx scripts/verify-archived-agent-notes.ts",
    "archive-plans": "node scripts/archive-plans.mjs",
    "set-version": "node scripts/set-version.mjs",
    "pack": "node scripts/pack.mjs",
    "check-lockstep": "node scripts/check-lockstep.mjs",
    "check-dist-sync": "node scripts/check-dist-sync.mjs",
    "gen-ops-api-inventory": "npx tsx scripts/gen-ops-api-inventory.ts",
    "check-ops-api-inventory": "npx tsx scripts/gen-ops-api-inventory.ts --check",
    "check-api-coverage": "npx tsx packages/core/scripts/check-api-coverage.ts",
    "gen:surface": "npx tsx packages/core/scripts/gen-l3-surface.ts",
    "doc-sync": "npx tsx scripts/gen-ops-api-inventory.ts --check && npx tsx scripts/verify-md-links.ts && npx tsx scripts/verify-md-wrap.ts && npx tsx scripts/verify-agent-note-format.ts && npx tsx scripts/verify-agent-note-classification.ts && npx tsx scripts/verify-translation-pairing.ts && npx tsx scripts/verify-type-equiv.ts && npx tsx scripts/verify-mermaid.ts && npx tsx scripts/verify-export-jsdoc.ts && npx tsx scripts/doc-typecheck.ts && npx tsx scripts/verify-doc-refs.ts && npx tsx scripts/verify-archived-agent-notes.ts",
    "test:watchdog": "node scripts/run-tests-with-watchdog.mjs -- npm run test",
    "test:workspaces:watchdog": "node scripts/run-tests-with-watchdog.mjs -- npm run test --workspaces --if-present"
  },
  "workspaces": [
    "packages/core",
    "packages/draw",
    "packages/sketch",
    "packages/faijs-extra",
    "packages/cq-compat-compare",
    "packages/faijs-gears",
    "packages/faijs-viewer",
    "packages/faijs-fasteners",
    "packages/sheetmetal",
    "packages/fixtures",
    "packages/tests",
    "packages/demo"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.4",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dompurify": "^3.4.16",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.12",
    "madge": "^8.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "occt-wasm": "5.6.0"
  }
}
