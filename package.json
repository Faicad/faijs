{
  "name": "@faicad/faijs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./browser": {
      "import": "./src/browser.ts",
      "types": "./src/browser.ts"
    },
    "./csg": {
      "import": "./src/csg.ts",
      "types": "./src/csg.ts"
    },
    "./sdf": {
      "import": "./src/sdf.ts",
      "types": "./src/sdf.ts"
    },
    "./node": {
      "import": "./src/node.ts",
      "types": "./src/node.ts"
    }
  },
  "files": [
    "src/"
  ],
  "description": "Faicad CAD execution engine — faijs language parser, BREP/mesh geometry ops, CadRuntime",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "manifold-3d": "^3.5.1",
    "occt-wasm": "^3.7.0",
    "opentype.js": "^1.3.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.4",
    "@types/three": "^0.184.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
