{
  "name": "@faicad/faijs",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./csg": {
      "types": "./dist/csg.d.ts",
      "import": "./dist/csg.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "import": "./dist/sdf.js"
    },
    "./stdlib": {
      "types": "./dist/stdlib/index.d.ts",
      "import": "./dist/stdlib/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist/"
  ],
  "description": "Faicad CAD execution engine — faijs language parser, BREP/mesh geometry ops, CadRuntime",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/fix-import-extensions.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "pack": "npm run build && npm pack",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "manifold-3d": "^3.5.1",
    "occt-wasm": "^3.7.0",
    "opentype.js": "^1.3.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.4",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xmldom/xmldom": "^0.9.11",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
