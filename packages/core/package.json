    "opentype.js": "^1.3.4"
  },
  "peerDependencies": {
    "occt-wasm": "^5.6.0",
    "three": "^0.162.0 || ^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "brepkit-wasm": "^3.4.18",
    "sucrase": "^3.35.1",
    "three": "^0.184.0",
    "three-162": "npm:three@^0.162.0",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "gen:capability-map": "tsx scripts/gen-capability-map.ts",
    "gen:brepkit-surface": "tsx scripts/gen-brepkit-surface.ts",
    "check:api-coverage": "npx tsx ../../scripts/check-api-test-coverage.ts --package=."
  }
