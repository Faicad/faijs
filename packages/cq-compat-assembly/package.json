{
  "name": "@faicad/cq-compat-assembly",
  "version": "0.26.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery-compatible assembly layer for faijs (Assembly.constrain -> solve()/toCompound()/save()) - split from @faicad/cq-compat",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "assembly",
    "solver"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {
    "@faicad/cq-compat": "^0.26.0",
    "@faicad/faijs-extra": "^0.26.0"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.26.0",
    "@faicad/faijs-extra": "^0.26.0",
    "occt-wasm": "^3.8.0"
  },
  "devDependencies": {
    "@faicad/faijs": "file:../core",
    "@faicad/faijs-extra": "file:../faijs-extra",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
