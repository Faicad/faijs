{
  "name": "@faicad/cq-compat-compare",
  "version": "0.30.9",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "STEP / assembly geometry equivalence comparers (dev-only) - split from @faicad/faijs-cadquery",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "step",
    "compare",
    "testing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.30.0",
    "occt-wasm": "^5.6.0"
  },
  "devDependencies": {
    "@faicad/faijs": "file:../core",
    "@faicad/faijs-cadquery": "^0.29.0",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
