{
  "name": "@faicad/cq-compat-sketch",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery Sketch layer for faijs (constraint-driven parameterized 2D sketches) — Phase 2 landing package, split from @faicad/cq-compat",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "sketch",
    "2d"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.13.0"
  },
  "devDependencies": {
    "@faicad/faijs": "file:../core",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
