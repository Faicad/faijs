{
  "name": "@faicad/cq-compat-sketch",
  "version": "0.26.2",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery Sketch.py-compatible 2D sketch container for faijs (geometry declarations + modes + selectors + sketch-to-extrude outlet). Constraints (planegcs) intentionally out of scope pending the LGPL verdict.",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "sketch",
    "2d"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {
    "@faicad/cq-compat": "file:../cq-compat"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.26.0",
    "occt-wasm": "^3.8.0"
  },
  "devDependencies": {
    "@faicad/faijs": "file:../core",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
