{
  "name": "@faicad/cq-compat",
  "version": "0.26.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery 2.8.0 geometry parity and assembly solver port for faijs",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "geometry",
    "brep",
    "assembly"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "autoLift": false
  },
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.26.0",
    "occt-wasm": "^3.8.0",
    "@faicad/faijs-sketch": "^0.26.0"
  },
  "devDependencies": {
    "@faicad/cq-compat-compare": "file:../cq-compat-compare",
    "@faicad/faijs": "file:../core",
    "opentype.js": "^1.3.4",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
