// source: test_selectors.py::TestCQSelectors::testEdgeTypesFilter (var c)
// c = Workplane().ellipse(3, 4).circle(1).extrude(1)
// "Tall" ellipse (y_radius 4 > x_radius 3) with a concentric r=1 hole,
// extruded 1 -> the assertions only count edge types; the exported geometry is
// the annular elliptical prism (vol = pi*3*4 - pi*1*1 = 34.557519).
//
// BLOCKED (kernel:ellipse-tall-axis): the kernel builds every ellipse with the
// major axis on global X and rejects major < minor ("gp_Elips: invalid
// construction parameters"), so a tall ellipse can only be produced by rotating
// a wide one — and every rotation entry point re-approximates the curve
// (applyMatrix/generalTransformWithHistory: +0.4% volume; plain transform /
// rotate: `makeFace` rejects the wire as non-planar). cq-compat fails loudly
// rather than emitting an approximated ellipse.
import * as cq from '@faicad/cq-compat'
let w1 = await cq.ellipse(cq.Workplane('XY'), 3, 4)
let w2 = await cq.circle(w1, 1)
let c = await cq.extrude(w2, 1)
let result = cq.val(c)
