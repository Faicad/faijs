{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["../core/dist/index.d.ts"],
      "@faicad/faijs/*": ["../core/dist/*"],
      "@faicad/faijs-extra": ["../faijs-extra/dist/index.d.ts"],
      "@faicad/faijs-extra/*": ["../faijs-extra/dist/*"],
      "@faicad/faijs-gears": ["../faijs-gears/dist/index.d.ts"],
      "@faicad/faijs-gears/*": ["../faijs-gears/dist/*"],
      "@faicad/sheetmetal": ["../sheetmetal/dist/index.d.ts"],
      "@faicad/sheetmetal/*": ["../sheetmetal/dist/*"]
    }
  },
  "include": ["**/*.ts"]
}
