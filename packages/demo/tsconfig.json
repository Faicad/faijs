{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["../core/src/index.ts"],
      "@faicad/faijs/*": ["../core/src/*"],
      "@faicad/faijs-extra": ["../faijs-extra/src/index.ts"],
      "@faicad/faijs-extra/*": ["../faijs-extra/src/*"],
      "@faicad/sheetmetal": ["../sheetmetal/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
