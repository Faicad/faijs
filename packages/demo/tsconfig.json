{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["../../src/index.ts"],
      "@faicad/faijs/*": ["../../src/*"],
      "@faicad/faijs-core": ["../core/src/index.ts"],
      "@faicad/faijs-core/*": ["../core/src/*"],
      "@faicad/gear-lib-demo": ["../gear-lib-demo/src/index.ts"],
      "@faicad/sheetmetal": ["../sheetmetal/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
