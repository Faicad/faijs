{
  "name": "@faicad/fai-cq-gears",
  "version": "0.13.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery gear extensions (spur, bevel, worm, rack, planetary) ported to faijs",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "gear",
    "spur",
    "bevel",
    "worm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "naming": {
      "kind": "unmodeled",
      "reason": "gear tooth flanks are bspline surfaces without a stable per-face index vocabulary (face count varies with tooth count)"
    }
  },
  "dependencies": {
    "@faicad/cq-compat": "^0.13.0"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.13.0",
    "occt-wasm": "^3.8.0"
  },
  "devDependencies": {
    "@faicad/cq-compat-compare": "file:../cq-compat-compare",
    "@faicad/faijs": "file:../core",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:spike": "vitest run src/profile.test.ts",
    "lint": "eslint src",
    "gen-reference": "pwsh -NoProfile scripts/gen-reference.ps1"
  }
}
