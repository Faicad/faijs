// source: test_cadquery.py::TestCadQuery::testMultisectionSweep (var arcSweep)
// path = (Workplane("XZ").moveTo(-5, 4).lineTo(0, 4)
//         .threePointArc((4, 0), (0, -4)).lineTo(-5, -4))     # line + arc + line
// arcSweep = (Workplane("YZ").workplane(offset=-5).moveTo(0, 4).circle(1.5)
//     .workplane(offset=5, centerOption="CenterOfMass").circle(1.5)
//     .moveTo(0, -8).circle(1.0)
//     .workplane(offset=-5, centerOption="CenterOfMass").circle(1.0)
//     .sweep(path, multisection=True))
// ref (cadquery 2.8.0): vol 114.061557 | area 187.5404 | 5 faces
//                       | bb x[-5,5.253] y[-1.533,1.533] z[-5.001,5.533]
//
// BLOCKED (kernel:sweep-multisection-pipe, reclassified from op:sweep.multisection
// 2026-10-04 — see tests/mark-blocked.ts): four sections interpolated along a
// CURVED spine (the threePointArc segment), so neither a straight-section `loft`
// nor any single-profile sweep can reproduce it. Upstream `Solid.sweep_multi`
// (shapes.py:4682) = one MakePipeShell + one `Add` per section; occt-wasm only
// exposes the single-profile `sweepPipeShell` wrapper (index.d.ts:169) with no
// multi-`Add` binding. Requires the kernel to expose multi-section `Add`
// (roadmap B2-3 / B6).
import * as cq from '@faicad/faijs-cadquery'
let path = cq.lineTo(cq.threePointArc(cq.lineTo(cq.moveTo(cq.Workplane('XZ'), -5, 4), 0, 4), [4, 0], [0, -4]), -5, -4)
let t0 = await cq.workplane(cq.Workplane('YZ'), { offset: -5 })
let t1 = cq.circle(cq.moveTo(t0, 0, 4), 1.5)
let t2 = cq.circle(await cq.workplane(t1, { offset: 5, centerOption: 'CenterOfMass' }), 1.5)
let t3 = cq.circle(cq.moveTo(t2, 0, -8), 1.0)
let t4 = cq.circle(await cq.workplane(t3, { offset: -5, centerOption: 'CenterOfMass' }), 1.0)
// 4 pending wires == 4 sections (upstream `multisection=True`)
let arcSweep = await cq.sweep(t4, path)
let result = cq.val(arcSweep)
