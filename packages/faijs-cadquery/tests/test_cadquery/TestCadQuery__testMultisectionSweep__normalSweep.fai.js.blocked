// source: test_cadquery.py::TestCadQuery::testMultisectionSweep (var normalSweep)
// pts = [(0, 0), (20, 100)]
// path = Workplane("YZ").spline(pts, tangents=[(0, 1, 0), (0, 1, 0)])
// normalSweep = (Workplane().rect(10, 10)
//     .workplane(offset=100).rect(10, 20)
//     .sweep(path, multisection=True, normal=(0, 1, 1)))
// ref (cadquery 2.8.0): vol 10606.601718 | area 4430.2550 | 6 faces
//                       | bb x[-5,5] y[-7.071,8.334] z[-3.536,107.071]
//
// BLOCKED (kernel:sweep-multisection-pipe, reclassified from op:sweep.multisection
// 2026-10-04 — see tests/mark-blocked.ts): TWO sections (rect 10x10 and rect
// 10x20) interpolated along a SPLINE spine, in fixed-up mode (normal=(0,1,1)).
// Upstream `Solid.sweep_multi` (shapes.py:4682) with `mode` set builds one
// MakePipeShell, calls `SetMode(FixedUp, up)` and `Add` once per section;
// occt-wasm has only the single-profile `sweepPipeShell` wrapper
// (index.d.ts:169) — no multi-`Add` binding. The single-profile `normal=`
// (SweepMode.FixedUp) path in faijs IS parity-verified, so only the
// multi-section half is missing. Requires the kernel to expose multi-section
// `Add` (roadmap B2-3 / B6).
//
// NOTE: the upstream assertions here are on the two end-face normals
// (`faces("<Z") /= (0,-1,-1)`, `faces(">Z") /= (0,1,1)`), which a single-section
// sweep cannot model because both sections are needed to set the twist.
import * as cq from '@faicad/faijs-cadquery'
// upstream passes tangents=[(0,1,0),(0,1,0)]; the faijs `spline` signature has no
// tangent argument, so the end-tangent form is noted, not expressed.
let path = cq.spline(cq.Workplane('YZ'), [[0, 0], [20, 100]])
let n0 = cq.Workplane()
let n1 = cq.rect(n0, 10, 10)
let n2 = cq.rect(await cq.workplane(n1, { offset: 100 }), 10, 20)
// 2 pending wires == 2 sections; `normal` = fixed up direction
let normalSweep = await cq.sweep(n2, path, { normal: [0, 1, 1] })
let result = cq.val(normalSweep)
