// source: test_cadquery.py::TestCadQuery::testTwistExtrudeCombineCut (var cut)
// cut = box.faces(">Z").workplane(invert=True).rect(1.5, 5)
//         .twistExtrude(10, 90, combine="cut")
// ref anchor: vol=924.998915786, bbox +/-5, topo f10/e24/v16/s1
import * as cq from '@faicad/cq-compat'
let box = await cq.box(cq.Workplane(), 10, 10, 10)
let fz = await cq.faces(box, '>Z')
let wp = await cq.workplane(fz, { invert: true })
wp = await cq.rect(wp, 1.5, 5)
let tool = await cq.twistExtrude(wp, 90, 10)
let cut = await cq.cut(box, cq.val(tool))
let result = cq.val(cut)
