{
  "name": "@faicad/faijs-extra",
  "version": "0.19.0",
  "description": "Editor extension library for faijs — fai_* ops, group/assembly/copy/load, and the svg / 3D-text creators",
  "keywords": [
    "faijs",
    "cad",
    "editor",
    "svg",
    "text",
    "three"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./editor-ops": {
      "types": "./dist/editor-ops.d.ts",
      "default": "./dist/editor-ops.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.18.0",
    "three": "^0.162.0 || ^0.184.0"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "three": "^0.184.0",
    "@types/three": "^0.184.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
