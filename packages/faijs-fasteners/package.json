{
  "name": "@faicad/faijs-fasteners",
  "version": "0.29.4",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "description": "CadQuery fasteners and hardware (nuts, screws, washers, bearings, sprockets) ported to faijs",
  "keywords": [
    "cad",
    "faijs",
    "cadquery",
    "fastener",
    "hardware",
    "nut",
    "screw",
    "bearing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.29.0",
    "occt-wasm": "^3.8.0"
  },
  "devDependencies": {
    "@faicad/cq-compat-compare": "file:../cq-compat-compare",
    "@faicad/faijs": "file:../core",
    "typescript": "*",
    "vitest": "*",
    "yaml": "^2.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "gen-data": "tsx scripts/gen-data.ts",
    "check-column-semantics": "tsx scripts/check-column-semantics.ts",
    "gen-reference": "pwsh -NoProfile scripts/gen-reference.ps1",
    "export-ours": "tsx scripts/export-ours.ts",
    "compare:all": "tsx scripts/compare-all.ts",
    "probe:pitfalls": "tsx scripts/kernel-pitfalls-probe.ts",
    "probe:nut": "tsx scripts/kernel-nut-probe.ts",
    "probe:screw": "tsx scripts/kernel-screw-probe.ts"
  }
}
