{
  "name": "@faicad/faijs-viewer",
  "version": "0.29.1",
  "description": "Read + execute + tessellate a project .fai.zip for any third-party host. v1 API: openFaiZip(bytes, { wasm: { occtUrl, manifoldUrl, brepkitUrl } })",
  "keywords": [
    "faijs",
    "fai",
    "zip",
    "viewer",
    "cad",
    "occt",
    "manifold",
    "three"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.29.0",
    "@faicad/faijs-draw": "^0.29.0",
    "@faicad/faijs-sketch": "^0.29.0",
    "occt-wasm": "3.8.4"
  },
  "devDependencies": {
    "@faicad/faijs": "link:../core",
    "occt-wasm": "^3.8.4",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}