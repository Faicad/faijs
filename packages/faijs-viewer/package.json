{
  "name": "@faicad/faijs-viewer",
  "version": "0.30.7",
  "description": "Read + execute + tessellate a project .fai.zip for any third-party host. v1 API: openFaiZip(bytes, { wasm: { occtUrl, manifoldUrl, brepkitUrl } })",
  "keywords": [
    "faijs",
    "fai",
    "zip",
    "viewer",
    "cad",
    "occt",
    "manifold",
    "three"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.30.0",
    "@faicad/faijs-extra": "^0.30.0",
    "@faicad/faijs-sketch": "^0.30.0",
    "occt-wasm": "5.6.0",
    "three": "^0.162.0 || ^0.184.0"
  },
  "devDependencies": {
    "@faicad/faijs": "file:../core",
    "@faicad/faijs-extra": "file:../faijs-extra",
    "@faicad/faijs-gears": "file:../faijs-gears",
    "@types/three": "^0.184.1",
    "occt-wasm": "^5.6.0",
    "three": "^0.184.0",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "check:api-coverage": "npx tsx ../../scripts/check-api-test-coverage.ts --package=."
  }
}
