{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["../core/src/index.ts"],
      "@faicad/faijs/browser": ["../core/src/browser.ts"],
      "@faicad/faijs/*": ["../core/src/*"],
      "@faicad/faijs-sketch": ["../sketch/src/index.ts"],
      "@faicad/faijs-sketch/node": ["../sketch/src/node.ts"],
      "@faicad/faijs-extra": ["../faijs-extra/src/index.ts"],
      "@faicad/faijs-extra/browser": ["../faijs-extra/src/browser.ts"],
      "@faicad/faijs-gears": ["../faijs-gears/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}