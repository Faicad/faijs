{
  "name": "@faicad/sheetmetal",
  "version": "0.13.2",
  "description": "Sheet-metal CAD domain for faijs — flange authoring, fold/unfold flat patterns (ported from brepjs-sheetmetal)",
  "keywords": [
    "sheet-metal",
    "cad",
    "faijs",
    "unfold",
    "flat-pattern",
    "bend-allowance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "faijs": {
    "naming": {
      "kind": "unmodeled",
      "reason": "sheetmetal flange/bend faces are swept bspline surfaces without a stable per-face index vocabulary"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@faicad/faijs": "^0.13.0"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
