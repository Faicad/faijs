{
  "name": "@faicad/faijs-sketch",
  "version": "0.29.1",
  "description": "faijs sketch & constraint capability library - canonical model, planegcs solving, contour extraction and face construction",
  "keywords": [
    "faijs",
    "cad",
    "sketch",
    "constraint",
    "solver",
    "planegcs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Faicad/faijs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "default": "./dist/canonical.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "@salusoft89/planegcs": "1.2.0"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.29.0"
  },
  "devDependencies": {
    "occt-wasm": "^3.8.4",
    "three": "^0.184.0",
    "@types/three": "^0.184.1",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:install": "vitest run -c vitest.install.config.ts",
    "lint": "eslint src"
  }
}
