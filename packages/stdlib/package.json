{
  "name": "@faicad/faijs-stdlib",
  "version": "0.7.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./internal-stdlib": { "types": "./dist/internal-stdlib.d.ts", "default": "./dist/internal-stdlib.js" },
    "./brepjs-mirror/*": { "types": "./dist/brepjs-mirror/*.d.ts", "default": "./dist/brepjs-mirror/*.js" }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "three": "^0.184.0"
  },
  "peerDependencies": {
    "@faicad/faijs-core": "^0.7.0",
    "occt-wasm": "^3.8.0"
  },
  "devDependencies": {
    "@faicad/faijs-core": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-import-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
