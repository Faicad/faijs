let part0 = cad.box({ size:20 })
let part1 = cad.box({ size:20, center:[10,0,0] })
let part2 = cad.union(part0, part1)
let part3 = cad.box({ size:20 })
let part4 = cad.sphere({ radius:10 })
let part5 = cad.subtract(part3, part4)
let part6 = cad.box({ size:20 })
let part7 = cad.sphere({ radius:12 })
let part8 = cad.intersect(part6, part7)
