{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["../core/src/index.ts"],
      "@faicad/faijs/*": ["../core/src/*"],
      "@faicad/faijs-extra": ["../faijs-extra/src/index.ts"],
      "@faicad/faijs-extra/*": ["../faijs-extra/src/*"],
      "@faicad/faijs-gears": ["../faijs-gears/src/index.ts"],
      "@faicad/faijs-gears/*": ["../faijs-gears/src/*"],
      "@faicad/faijs-sketch": ["../sketch/src/index.ts"],
      "@faicad/faijs-sketch/*": ["../sketch/src/*"],
      "@faicad/sheetmetal": ["../sheetmetal/src/index.ts"],
      "@faicad/sheetmetal/*": ["../sheetmetal/src/*"],
      "@faicad/faijs-fixtures": ["../fixtures/data"]
    }
  },
  "include": [
    "faijs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
