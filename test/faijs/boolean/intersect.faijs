// apiVersion: 1
// Tests intersect operation
export default async (cad) => {
  const part0_v0 = cad.box({ size: 20 })
  const part0_v1 = cad.sphere({ radius: 12, center: [0, 0, 0] })
  const part0_v2 = cad.intersect(part0_v0, part0_v1)
  return { shape: part0_v2, name: 'intersect-test' }
}
