// apiVersion: 1
// Tests BREP/mesh parity for text engraving
export default async (cad) => {
  const part0_v0 = cad.box({ size: 50 })
  const part0_v1 = cad.translate({ offset: [0, 0, 24] }, part0_v0)
  const part0_v2 = cad.text({ text: 'TEST', size: 10, depth: 3 }, part0_v1)
  return { shape: part0_v2, name: 'parity-text' }
}
