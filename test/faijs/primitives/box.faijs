// apiVersion: 1
// Tests box with different parameter forms
export default async (cad) => {
  const part0_v0 = cad.box({ size: 20 })
  const part0_v1 = cad.box({ size: [10, 20, 30] })
  const part0_v2 = cad.box({ size: 15, center: [5, 5, 5] })
  return { shape: part0_v2, name: 'box-variants' }
}
