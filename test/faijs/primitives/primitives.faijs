let part0 = cad.box({ size:20 })
let part1 = cad.box({ size:[30,20,10] })
let part2 = cad.box({ size:15, center:[10,0,0] })
let part3 = cad.sphere({ radius:10 })
let part4 = cad.cylinder({ radius:5, height:20 })
let part5 = cad.cone({ radiusBottom:8, radiusTop:0, height:15 })
let part6 = cad.cone({ radiusBottom:8, radiusTop:4, height:15 })
let part7 = cad.wedge({ width:20, height:15, angle:45, length:30 })
