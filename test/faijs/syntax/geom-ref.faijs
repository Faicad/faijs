// apiVersion: 1
// Tests GeomRef (faceCenter, faceNormal)
// Note: In real usage, faceCenter/faceNormal would reference actual geometry
export default async (cad) => {
  const part0_v0 = cad.box({ size: 20 })
  // GeomRef would be used with actual face references
  // For testing, we just verify the syntax is accepted
  const part0_v1 = cad.translate({ offset: [10, 0, 0] }, part0_v0)
  return { shape: part0_v1, name: 'geom-ref-test' }
}
