// apiVersion: 1
// Tests rotate operation with and without pivot
export default async (cad) => {
  const part0_v0 = cad.box({ size: 20 })
  const part0_v1 = cad.rotate({ anglesDeg: [45, 0, 0] }, part0_v0)
  const part0_v2 = cad.rotate({ anglesDeg: [0, 90, 0], pivot: [0, 0, 10] }, part0_v0)
  return { shape: part0_v2, name: 'rotate-test' }
}
