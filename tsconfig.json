{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@faicad/faijs": ["./packages/core/src/index.ts"],
      "@faicad/faijs/*": ["./packages/core/src/*"],
      "@faicad/faijs-extra": ["./packages/faijs-extra/src/index.ts"],
      "@faicad/faijs-extra/*": ["./packages/faijs-extra/src/*"],
      "@faicad/faijs-sketch": ["./packages/sketch/src/index.ts"],
      "@faicad/faijs-sketch/*": ["./packages/sketch/src/*"],
      "@faicad/faijs-draw": ["./packages/draw/src/index.ts"],
      "@faicad/faijs-draw/*": ["./packages/draw/src/*"],
      "@faicad/faijs-cadquery": ["./packages/faijs-cadquery/src/index.ts"],
      "@faicad/faijs-cadquery/*": ["./packages/faijs-cadquery/src/*"],
      "@faicad/cq-compat-sketch": ["./packages/cq-compat-sketch/src/index.ts"],
      "@faicad/cq-compat-assembly": ["./packages/cq-compat-assembly/src/index.ts"],
      "@faicad/cq-compat-compare": ["./packages/cq-compat-compare/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "vitest.config.ts"
  ]
}